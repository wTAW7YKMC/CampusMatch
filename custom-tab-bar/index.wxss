/* 自定义底部 TabBar —— 二次元/霓虹风格 */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(15, 10, 26, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 2rpx solid rgba(139, 92, 246, 0.4);
  box-shadow: 0 -4rpx 24rpx rgba(139, 92, 246, 0.2);
  z-index: 9999;
}

.tab-bar::before {
  content: "";
  position: absolute;
  top: -2rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--neon-violet) 50%, transparent 100%);
  box-shadow: 0 0 12rpx var(--neon-violet);
}

.tab-list {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 96rpx;
  padding: 8rpx 0 0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 8rpx 0;
  transition: transform 0.15s;
}

.tab-item:active {
  transform: scale(0.92);
}

.tab-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 4rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.tab-icon {
  font-size: 36rpx;
  filter: grayscale(0.3);
  transition: all 0.2s;
}

.tab-text {
  font-family: var(--font-display);
  font-size: 20rpx;
  color: var(--paper-white);
  opacity: 0.6;
  transition: all 0.2s;
}

.tab-indicator {
  position: absolute;
  bottom: 4rpx;
  width: 32rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--gradient-violet-pink);
  box-shadow: 0 0 10rpx var(--neon-pink);
  animation: indicator-pulse 1.5s infinite ease-in-out;
}

@keyframes indicator-pulse {
  0%, 100% { opacity: 0.8; transform: scaleX(1); }
  50% { opacity: 1; transform: scaleX(1.3); }
}

/* 激活态 */
.tab-active .tab-icon-wrap {
  background: rgba(139, 92, 246, 0.18);
  box-shadow: 0 0 16rpx var(--violet-60), inset 0 0 0 2rpx rgba(139, 92, 246, 0.4);
  transform: translateY(-8rpx) rotate(-4deg);
}

.tab-active .tab-icon {
  filter: grayscale(0) drop-shadow(0 0 6rpx var(--neon-violet));
  transform: scale(1.15);
}

.tab-active .tab-text {
  color: var(--neon-violet);
  opacity: 1;
  text-shadow: 0 0 8rpx var(--violet-80);
}

/* 中间发布按钮（C位放大） */
.tab-item:nth-child(2) .tab-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: var(--gradient-cyan-violet);
  border-radius: 50%;
  margin-top: -24rpx;
  box-shadow: 0 0 0 4rpx rgba(15, 10, 26, 0.9), 0 0 20rpx var(--cyan-80);
}

.tab-item:nth-child(2) .tab-icon {
  font-size: 40rpx;
  color: #ffffff;
}

.tab-item:nth-child(2).tab-active .tab-icon-wrap {
  transform: translateY(-8rpx) rotate(8deg);
  box-shadow: 0 0 0 4rpx rgba(15, 10, 26, 0.9), 0 0 28rpx var(--neon-cyan);
}

/* NEW 角标 */
.tab-badge {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  padding: 2rpx 8rpx;
  background: var(--neon-pink);
  color: #ffffff;
  font-family: var(--font-display);
  font-size: 16rpx;
  font-weight: 700;
  border-radius: 12rpx;
  box-shadow: 0 0 10rpx var(--pink-80);
  transform: rotate(12deg);
  animation: badge-bounce 1.2s infinite ease-in-out;
}

@keyframes badge-bounce {
  0%, 100% { transform: rotate(12deg) translateY(0); }
  50% { transform: rotate(12deg) translateY(-4rpx); }
}

/* 扫描线装饰 */
.otaku-scanline::after {
  top: 0;
  animation: scanline 2.5s linear infinite;
}

@keyframes scanline {
  0% { transform: translateY(-100%); }
  100% { transform: translateY(600%); }
}