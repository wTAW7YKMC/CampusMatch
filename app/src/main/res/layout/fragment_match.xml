<?xml version="1.0" encoding="utf-8"?>
<!-- 智能匹配页面 ⭐核心功能 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 需求输入区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_blue"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="告诉🤖AI你想要什么"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="用自然语言描述需求，AI为你精准匹配"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp" />

            <!-- 输入框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 你好！告诉我你想买什么，比如："
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- 示例标签 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/match_example_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_blue"
                        android:padding="6dp"
                        android:text="管理学教材\n预算30元以内"
                        android:textColor="@color/blue_primary"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/match_example_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_blue"
                        android:padding="6dp"
                        android:text="护眼台灯九成新\n北区优先"
                        android:textColor="@color/blue_primary"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/match_example_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tag_blue"
                        android:padding="6dp"
                        android:text="蓝牙耳机\n预算100左右"
                        android:textColor="@color/blue_primary"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 输入区 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/bg_main"
                    android:padding="8dp">
                    <EditText
                        android:id="@+id/match_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="top"
                        android:hint="例如：我想买一本管理学教材，预算30元以内，最好在北区..."
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 开始匹配按钮 -->
            <TextView
                android:id="@+id/match_start_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_gradient_yellow"
                android:gravity="center"
                android:text="✨ 开始匹配"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 匹配结果区（默认隐藏） -->
        <LinearLayout
            android:id="@+id/match_result_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- 结果头部 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/match_result_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="找到 3 件匹配商品"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/match_parsed_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- 匹配商品列表 -->
            <LinearLayout
                android:id="@+id/match_product_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- 底部间距 -->
        <View android:layout_width="match_parent" android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>