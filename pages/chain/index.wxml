<view class="container">
  <view class="hero-card">
    <view>
      <view class="hero-title">交换挑战局</view>
      <view class="hero-subtitle">发现多边交换机会，让闲置物品连起来</view>
    </view>

    <button class="refresh-btn" bindtap="refreshChains">刷新</button>
  </view>

  <view wx:if="{{loading}}" class="empty-card">
    <view class="empty-icon">⏳</view>
    <view class="empty-title">挑战局加载中</view>
  </view>

  <view wx:elif="{{!chains.length}}" class="empty-card">
    <view class="empty-icon">🔗</view>
    <view class="empty-title">暂无交换挑战局</view>
    <view class="empty-text">可以先在 Supabase 的 chains 表中添加真实挑战局。</view>
  </view>

  <block wx:else>
    <block wx:for="{{chains}}" wx:key="chainId">
      <view class="chain-card">
        <view class="chain-head">
          <view>
            <view class="chain-title">{{item.title}}</view>
            <view class="chain-reason">{{item.reason || '系统发现了潜在多边交换机会'}}</view>
          </view>

          <view class="score-box">
            <view class="score">{{item.score}}</view>
            <view class="score-label">匹配分</view>
          </view>
        </view>

        <view class="node-list">
          <block wx:for="{{item.nodes}}" wx:key="index" wx:for-item="node">
            <view class="node">
              <view class="node-name">{{node.name || '参与者'}}</view>
              <view class="node-item">{{node.item || '待交换物品'}}</view>
            </view>

            <view wx:if="{{index < item.nodes.length - 1}}" class="arrow">→</view>
          </block>
        </view>

        <view class="reward-row">
          <text>奖励：+{{item.rewardBrain}} 脑洞值</text>
          <text>+{{item.rewardEnergy}} 闲置能量</text>
        </view>

        <button
          class="join-btn {{item.joined ? 'joined' : ''}}"
          data-id="{{item.chainId}}"
          bindtap="joinChain"
        >
          {{item.joined ? '已加入' : '加入挑战局'}}
        </button>
      </view>
    </block>
  </block>
</view>
