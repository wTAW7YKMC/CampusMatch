.container {
    min-height: 100vh;
    padding: 28rpx;
    padding-bottom: 120rpx;
    box-sizing: border-box;
    background: #f8f5f2;
  }
  
  .hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 38rpx;
    border-radius: 36rpx;
    background: linear-gradient(135deg, #111111, #9ca3af);
    color: #ffffff;
    box-shadow: 0 18rpx 60rpx rgba(31, 20, 71, 0.12);
  }
  
  .hero-title {
    font-size: 44rpx;
    font-weight: 900;
  }
  
  .hero-subtitle {
    margin-top: 12rpx;
    font-size: 26rpx;
    opacity: 0.92;
  }
  
  .refresh-btn {
    margin: 0;
    padding: 0 26rpx;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.8);
    color: #ffffff;
    font-size: 24rpx;
  }
  
  .refresh-btn::after,
  .join-btn::after {
    border: none;
  }
  
  .chain-card {
    margin-top: 28rpx;
    padding: 34rpx;
    border-radius: 36rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .chain-head {
    display: flex;
    justify-content: space-between;
    gap: 24rpx;
  }
  
  .chain-title {
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .chain-reason {
    margin-top: 12rpx;
    color: #8b7ca8;
    font-size: 24rpx;
    line-height: 1.5;
  }
  
  .score-box {
    width: 110rpx;
    padding: 18rpx 0;
    border-radius: 28rpx;
    background: #f7f3ff;
    text-align: center;
    flex-shrink: 0;
  }
  
  .score {
    color: #111111;
    font-size: 38rpx;
    font-weight: 900;
  }
  
  .score-label {
    margin-top: 4rpx;
    color: #8b7ca8;
    font-size: 20rpx;
  }
  
  .node-list {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-top: 30rpx;
    overflow-x: auto;
  }
  
  .node {
    min-width: 170rpx;
    padding: 22rpx;
    border-radius: 24rpx;
    background: #f7f3ff;
    flex-shrink: 0;
  }
  
  .node-name {
    color: #8b7ca8;
    font-size: 22rpx;
  }
  
  .node-item {
    margin-top: 10rpx;
    color: #1a1025;
    font-size: 26rpx;
    font-weight: 900;
  }
  
  .arrow {
    color: #111111;
    font-size: 34rpx;
    font-weight: 900;
    flex-shrink: 0;
  }
  
  .reward-row {
    display: flex;
    gap: 20rpx;
    margin-top: 28rpx;
    color: #6b5b8a;
    font-size: 24rpx;
  }
  
  .join-btn {
    margin-top: 28rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 28rpx;
    background: #111111;
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 800;
  }
  
  .join-btn.joined {
    background: #f3f4f6;
    color: #6b5b8a;
  }
  
  .empty-card {
    margin-top: 28rpx;
    padding: 60rpx 36rpx;
    border-radius: 36rpx;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .empty-icon {
    font-size: 72rpx;
  }
  
  .empty-title {
    margin-top: 20rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .empty-text {
    margin-top: 14rpx;
    color: #8b7ca8;
    font-size: 26rpx;
    line-height: 1.6;
  }
  