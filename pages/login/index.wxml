<view class="page">
  <view class="card">
    <view class="logo">校换</view>

    <view class="title">
      {{mode === 'login' ? '欢迎回来' : '创建账号'}}
    </view>

    <view class="subtitle">
      {{mode === 'login' ? '登录后同步你的交换数据' : '注册后开启校园换物之旅'}}
    </view>

    <input
      class="input"
      placeholder="邮箱"
      value="{{email}}"
      bindinput="onEmailInput"
    />

    <input
      class="input"
      password
      placeholder="密码，至少 6 位"
      value="{{password}}"
      bindinput="onPasswordInput"
    />

    <block wx:if="{{mode === 'register'}}">
      <input
        class="input"
        placeholder="昵称"
        value="{{nickName}}"
        bindinput="onNickInput"
      />

      <input
        class="input"
        placeholder="学校"
        value="{{school}}"
        bindinput="onSchoolInput"
      />

      <input
        class="input"
        placeholder="年级"
        value="{{grade}}"
        bindinput="onGradeInput"
      />
    </block>

    <button
      class="submit-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="submit"
    >
      {{mode === 'login' ? '登录' : '注册'}}
    </button>

    <view class="switch" bindtap="switchMode">
      {{mode === 'login' ? '没有账号？立即注册' : '已有账号？去登录'}}
    </view>
  </view>
</view>
