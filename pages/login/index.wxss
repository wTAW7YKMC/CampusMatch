.page {
    min-height: 100vh;
    padding: 96rpx 40rpx;
    box-sizing: border-box;
    background: linear-gradient(180deg, #f7f2ff 0%, #f8f5f2 100%);
  }
  
  .card {
    padding: 56rpx 44rpx;
    border-radius: 40rpx;
    background: #ffffff;
    box-shadow: 0 24rpx 80rpx rgba(31, 20, 71, 0.12);
  }
  
  .logo {
    width: 112rpx;
    height: 112rpx;
    line-height: 112rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #111111;
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 800;
  }
  
  .title {
    margin-top: 40rpx;
    font-size: 48rpx;
    font-weight: 800;
    color: #111827;
  }
  
  .subtitle {
    margin-top: 16rpx;
    margin-bottom: 48rpx;
    color: #6b7280;
    font-size: 28rpx;
    line-height: 1.6;
  }
  
  .input {
    height: 92rpx;
    margin-bottom: 24rpx;
    padding: 0 28rpx;
    border-radius: 26rpx;
    background: #f3f4f6;
    color: #111827;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  .submit-btn {
    margin-top: 20rpx;
    height: 96rpx;
    line-height: 96rpx;
    border-radius: 30rpx;
    background: #111111;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 700;
  }
  
  .submit-btn[disabled] {
    background: #a5a0ff;
    color: #ffffff;
  }
  
  .switch {
    margin-top: 36rpx;
    text-align: center;
    color: #111111;
    font-size: 28rpx;
    font-weight: 600;
  }
  