.form { padding:24rpx; margin:20rpx 0; }
.input { width:100%; box-sizing:border-box; background:#f7f8fc; border-radius:16rpx; padding:20rpx; font-size:28rpx; }
.second { margin-top:16rpx; }
.submit { margin-top:18rpx; height:86rpx; line-height:86rpx; }
.wish { padding:24rpx; margin-bottom:18rpx; }
.wish-head { display:flex; justify-content:space-between; align-items:center; }
.wish-name { font-size:30rpx; font-weight:700; }
.count { color:#ff8a00; font-weight:700; font-size:24rpx; }
.tip { margin-top:12rpx; color:#555; font-size:24rpx; }
.go { margin-top:16rpx; height:76rpx; line-height:72rpx; font-size:25rpx; }
