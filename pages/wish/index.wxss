.container {
    min-height: 100vh;
    padding: 28rpx;
    padding-bottom: 120rpx;
    box-sizing: border-box;
    background: #f8f5f2;
  }
  
  .hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 38rpx;
    border-radius: 36rpx;
    background: linear-gradient(135deg, #111111, #9ca3af);
    color: #ffffff;
    box-shadow: 0 18rpx 60rpx rgba(31, 20, 71, 0.12);
  }
  
  .hero-title {
    font-size: 44rpx;
    font-weight: 900;
  }
  
  .hero-subtitle {
    margin-top: 12rpx;
    font-size: 26rpx;
    line-height: 1.5;
    opacity: 0.92;
  }
  
  .refresh-btn {
    margin: 0;
    padding: 0 26rpx;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.8);
    color: #ffffff;
    font-size: 24rpx;
  }
  
  .refresh-btn::after,
  .submit-btn::after {
    border: none;
  }
  
  .form-card {
    margin-top: 28rpx;
    padding: 34rpx;
    border-radius: 36rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .form-title {
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .input {
    width: 100%;
    height: 88rpx;
    margin-top: 24rpx;
    padding: 0 28rpx;
    border-radius: 24rpx;
    background: #f7f3ff;
    color: #1a1025;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  .picker-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 88rpx;
    margin-top: 24rpx;
    padding: 0 28rpx;
    border-radius: 24rpx;
    background: #f7f3ff;
    color: #1a1025;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  .submit-btn {
    margin-top: 28rpx;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 28rpx;
    background: #111111;
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 800;
  }
  
  .login-tip {
    margin-top: 22rpx;
    text-align: center;
    color: #8b7ca8;
    font-size: 24rpx;
  }
  
  .section-title {
    margin-top: 36rpx;
    margin-bottom: 20rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .wish-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24rpx;
    margin-bottom: 22rpx;
    padding: 32rpx;
    border-radius: 32rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .wish-main {
    flex: 1;
    min-width: 0;
  }
  
  .wish-name {
    color: #1a1025;
    font-size: 32rpx;
    font-weight: 900;
  }
  
  .wish-meta {
    margin-top: 10rpx;
    color: #8b7ca8;
    font-size: 24rpx;
  }
  
  .tag {
    display: inline-block;
    margin-top: 16rpx;
    padding: 8rpx 18rpx;
    border-radius: 999rpx;
    background: #f7f3ff;
    color: #111111;
    font-size: 22rpx;
    font-weight: 800;
  }
  
  .wish-count {
    width: 120rpx;
    text-align: center;
    flex-shrink: 0;
  }
  
  .count {
    color: #111111;
    font-size: 42rpx;
    font-weight: 900;
  }
  
  .count-label {
    margin-top: 4rpx;
    color: #8b7ca8;
    font-size: 22rpx;
  }
  
  .empty-card {
    padding: 60rpx 36rpx;
    border-radius: 36rpx;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .empty-icon {
    font-size: 72rpx;
  }
  
  .empty-title {
    margin-top: 20rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .empty-text {
    margin-top: 14rpx;
    color: #8b7ca8;
    font-size: 26rpx;
  }
  