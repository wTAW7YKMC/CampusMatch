.profile {
  padding: 28rpx;
  text-align: center;
  margin-bottom: 22rpx;
}

page {
  background: #f8f5f2;
}

.badge-title {
  color: #1a1025;
}

.menu-item {
  color: #1a1025;
}

.muted {
  color: #6b5b8a;
  opacity: 1;
}

.name-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1025;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ecebff;
}

.score-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #444;
}

.menu {
  padding: 12rpx 0;
}

.menu-item {
  padding: 28rpx;
  border-bottom: 1rpx solid #eef0f4;
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: none;
}


.play-metrics {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.metric {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  background: #f7f8fc;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #111111;
}

.metric-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #777;
}

.badges {
  padding: 24rpx;
  margin-bottom: 22rpx;
}

.badge-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.badge-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fun-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #d98200;
  font-size: 23rpx;
}

.task-line { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 25rpx; color: #555; border-bottom: 1rpx solid #f0f1f7; }
.task-line:last-child { border-bottom: none; }
.reset { color: #ff5c5c; }

.container {
    min-height: 100vh;
    padding: 28rpx;
    padding-bottom: 160rpx;
    box-sizing: border-box;
  }
  
  .login-card {
    padding: 48rpx 32rpx;
    text-align: center;
    margin-bottom: 22rpx;
  }
  
  .login-title {
    margin-top: 24rpx;
    font-size: 40rpx;
    font-weight: 800;
    color: #1a1025;
  }
  
  .login-subtitle {
    margin-top: 16rpx;
    color: #6b5b8a;
    font-size: 26rpx;
    line-height: 1.6;
  }
  
  .login-btn {
    margin-top: 36rpx;
    height: 88rpx;
    line-height: 88rpx;
    border-radius: 28rpx;
    background: #111111;
    color: #ffffff;
    font-weight: 700;
  }
  
  .empty-text {
    color: #999;
    font-size: 26rpx;
  }
  .input {
    width: 100%;
    height: 88rpx;
    margin-top: 22rpx;
    padding: 0 28rpx;
    border-radius: 24rpx;
    background: #f7f3ff;
    color: #1a1025;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  .auth-switch {
    margin-top: 28rpx;
    text-align: center;
    color: #111111;
    font-size: 26rpx;
    font-weight: 700;
  }
  
  .logout-btn {
    margin-top: 32rpx;
    height: 76rpx;
    line-height: 76rpx;
    border-radius: 24rpx;
    background: #f3f4f6;
    color: #6b5b8a;
    font-size: 26rpx;
  }
  
  .logout-btn::after {
    border: none;
  }
  .second-row {
    margin-top: 18rpx;
  }
  
  .list-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  }
  
  .list-row:last-child {
    border-bottom: none;
  }
  
  .list-title {
    color: #1a1025;
    font-size: 28rpx;
    font-weight: 800;
  }
  
  .list-desc {
