.profile {
  padding: 28rpx;
  text-align: center;
  margin-bottom: 22rpx;
}

.name-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #ecebff;
}

.score-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #444;
}

.menu {
  padding: 12rpx 0;
}

.menu-item {
  padding: 28rpx;
  border-bottom: 1rpx solid #eef0f4;
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: none;
}


.play-metrics {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.metric {
  flex: 1;
  padding: 18rpx 8rpx;
  border-radius: 18rpx;
  background: #f7f8fc;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #6c63ff;
}

.metric-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #777;
}

.badges {
  padding: 24rpx;
  margin-bottom: 22rpx;
}

.badge-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.badge-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.fun-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff7e6;
  color: #d98200;
  font-size: 23rpx;
}

.task-line { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 25rpx; color: #555; border-bottom: 1rpx solid #f0f1f7; }
.task-line:last-child { border-bottom: none; }
.reset { color: #ff5c5c; }
