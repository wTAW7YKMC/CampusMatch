.lab { padding: 24rpx; }
.submit { margin-top: 16rpx; height: 92rpx; line-height: 92rpx; }
.idea-list { margin-top: 20rpx; }
.idea { padding: 22rpx; margin-bottom: 16rpx; font-size: 28rpx; line-height: 42rpx; }
.input { width: 100%; box-sizing: border-box; background: #f7f8fc; border-radius: 16rpx; padding: 20rpx; font-size: 28rpx; color: #1a1025; }
.placeholder { color: #6b5b8a; }
.second { margin-top: 16rpx; }
.ai-card { padding: 24rpx; margin-top: 20rpx; background: linear-gradient(135deg,#f5f4ff,#fff7e6); }
.card-title { font-size: 30rpx; font-weight: 700; }
.card-meta { margin-top: 8rpx; color: #111111; font-size: 24rpx; }
.card-reason { margin-top: 14rpx; color: #555; font-size: 25rpx; line-height: 38rpx; }
.alt-row { margin-top: 14rpx; }
.alt-chip { display: inline-block; padding: 8rpx 14rpx; margin: 0 10rpx 10rpx 0; border-radius: 999rpx; background: #e9f7ee; color: #2e8b57; font-size: 22rpx; }
.use-btn { margin-top: 12rpx; height: 78rpx; line-height: 74rpx; font-size: 26rpx; }
