.container {
    min-height: 100vh;
    padding: 28rpx;
    padding-bottom: 120rpx;
    box-sizing: border-box;
    background: #f8f5f2;
  }
  
  .hero-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 38rpx;
    border-radius: 36rpx;
    background: linear-gradient(135deg, #111111, #9ca3af);
    color: #ffffff;
    box-shadow: 0 18rpx 60rpx rgba(31, 20, 71, 0.12);
  }
  
  .hero-title {
    font-size: 44rpx;
    font-weight: 900;
  }
  
  .hero-subtitle {
    margin-top: 12rpx;
    font-size: 26rpx;
    opacity: 0.9;
  }
  
  .refresh-btn {
    margin: 0;
    padding: 0 26rpx;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.8);
    color: #ffffff;
    font-size: 24rpx;
  }
  
  .refresh-btn::after {
    border: none;
  }
  
  .tabs {
    display: flex;
    gap: 18rpx;
    margin-top: 26rpx;
  }
  
  .tab {
    flex: 1;
    height: 72rpx;
    line-height: 72rpx;
    border-radius: 24rpx;
    text-align: center;
    background: #ffffff;
    color: #6b5b8a;
    font-size: 26rpx;
    font-weight: 700;
    box-shadow: 0 10rpx 32rpx rgba(31, 20, 71, 0.06);
  }
  
  .tab.active {
    background: #111111;
    color: #ffffff;
  }
  
  .section-title {
    margin-top: 36rpx;
    margin-bottom: 20rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .rank-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
    padding: 30rpx;
    border-radius: 32rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .top-card {
    border: 2rpx solid rgba(108, 99, 255, 0.2);
  }
  
  .rank-left {
    display: flex;
    align-items: center;
    gap: 22rpx;
  }
  
  .medal {
    width: 76rpx;
    height: 76rpx;
    line-height: 76rpx;
    text-align: center;
    border-radius: 24rpx;
    background: #f7f3ff;
    color: #111111;
    font-size: 30rpx;
    font-weight: 900;
  }
  
  .name {
    color: #1a1025;
    font-size: 30rpx;
    font-weight: 900;
  }
  
  .school {
    margin-top: 8rpx;
    color: #8b7ca8;
    font-size: 24rpx;
  }
  
  .rank-value {
    text-align: right;
  }
  
  .value {
    color: #111111;
    font-size: 42rpx;
    font-weight: 900;
  }
  
  .unit {
    margin-top: 4rpx;
    color: #8b7ca8;
    font-size: 22rpx;
  }
  
  .empty-card {
    margin-top: 24rpx;
    padding: 60rpx 36rpx;
    border-radius: 36rpx;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .empty-icon {
    font-size: 72rpx;
  }
  
  .empty-title {
    margin-top: 20rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .empty-text {
    margin-top: 14rpx;
    color: #8b7ca8;
    font-size: 26rpx;
    line-height: 1.6;
  }
  