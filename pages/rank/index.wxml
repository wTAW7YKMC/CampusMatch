<view class="container">
  <view class="hero-card">
    <view>
      <view class="hero-title">校园排行榜</view>
      <view class="hero-subtitle">根据 Supabase 云端数据实时生成</view>
    </view>

    <button class="refresh-btn" bindtap="refreshRank">刷新</button>
  </view>

  <view class="tabs">
    <block wx:for="{{tabs}}" wx:key="key">
      <view
        class="tab {{activeType === item.key ? 'active' : ''}}"
        data-type="{{item.key}}"
        bindtap="switchRank"
      >
        {{item.label}}
      </view>
    </block>
  </view>

  <view class="section-title">{{currentTitle}}</view>

  <view wx:if="{{loading}}" class="empty-card">
    <view class="empty-icon">⏳</view>
    <view class="empty-title">加载中</view>
  </view>

  <view wx:elif="{{!rankRows.length}}" class="empty-card">
    <view class="empty-icon">🏆</view>
    <view class="empty-title">{{emptyText}}</view>
    <view class="empty-text">发布、提案、认证和完成交换后，排行榜会自动变化。</view>
  </view>

  <block wx:else>
    <block wx:for="{{rankRows}}" wx:key="rank">
      <view class="rank-card {{item.rank <= 3 ? 'top-card' : ''}}">
        <view class="rank-left">
          <view class="medal">{{item.medal}}</view>

          <view>
            <view class="name">{{item.nickName}}</view>
            <view class="school">{{item.school}}</view>
          </view>
        </view>

        <view class="rank-value">
          <view class="value">{{item.value}}</view>
          <view class="unit">{{item.unit}}</view>
        </view>
      </view>
    </block>
  </block>
</view>
