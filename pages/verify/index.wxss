.container {
    min-height: 100vh;
    padding: 32rpx;
    box-sizing: border-box;
    background: #f8f5f2;
  }
  
  .hero-card,
  .form-card,
  .success-card {
    padding: 36rpx;
    border-radius: 36rpx;
    background: #ffffff;
    box-shadow: 0 18rpx 60rpx rgba(31, 20, 71, 0.08);
  }
  
  .hero-card {
    margin-bottom: 28rpx;
    background: linear-gradient(135deg, #111111, #9ca3af);
    color: #ffffff;
  }
  
  .title {
    font-size: 44rpx;
    font-weight: 900;
  }
  
  .subtitle {
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
    opacity: 0.92;
  }
  
  .field {
    margin-bottom: 28rpx;
  }
  
  .label {
    margin-bottom: 12rpx;
    font-size: 26rpx;
    font-weight: 700;
    color: #1a1025;
  }
  
  .input {
    height: 88rpx;
    padding: 0 28rpx;
    border-radius: 24rpx;
    background: #f7f3ff;
    color: #1a1025;
    font-size: 28rpx;
    box-sizing: border-box;
  }
  
  .submit-btn {
    margin-top: 24rpx;
    height: 92rpx;
    line-height: 92rpx;
    border-radius: 28rpx;
    background: #111111;
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 800;
  }
  
  .submit-btn[disabled] {
    background: #a5a0ff;
    color: #ffffff;
  }
  
  .success-card {
    text-align: center;
  }
  
  .success-icon {
    font-size: 72rpx;
  }
  
  .success-title {
    margin-top: 24rpx;
    font-size: 36rpx;
    font-weight: 800;
    color: #1a1025;
  }
  
  .success-text {
    margin-top: 16rpx;
    color: #6b5b8a;
    font-size: 26rpx;
  }
  