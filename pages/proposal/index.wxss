.form {
  padding: 24rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 700;
  margin: 18rpx 0 12rpx;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fc;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.textarea {
  min-height: 220rpx;
}

.submit {
  margin-top: 18rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.target { padding: 22rpx; margin-bottom: 18rpx; }
.target-title { font-size: 28rpx; font-weight: 700; margin-bottom: 8rpx; }
.ai-btn { margin: 18rpx 0; height: 80rpx; line-height: 76rpx; font-size: 26rpx; }
.ai-box { padding: 18rpx; margin-bottom: 18rpx; border-radius: 16rpx; background: #fff7e6; color: #7a4b00; font-size: 24rpx; line-height: 36rpx; }
