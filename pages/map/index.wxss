.container {
    min-height: 100vh;
    padding: 28rpx;
    padding-bottom: 120rpx;
    box-sizing: border-box;
    background: #f8f5f2;
  }
  
  .hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 38rpx;
    border-radius: 36rpx;
    background: linear-gradient(135deg, #111111, #9ca3af);
    color: #ffffff;
    box-shadow: 0 18rpx 60rpx rgba(31, 20, 71, 0.12);
  }
  
  .hero-title {
    font-size: 44rpx;
    font-weight: 900;
  }
  
  .hero-subtitle {
    margin-top: 12rpx;
    font-size: 26rpx;
    line-height: 1.5;
    opacity: 0.92;
  }
  
  .refresh-btn {
    margin: 0;
    padding: 0 26rpx;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.8);
    color: #ffffff;
    font-size: 24rpx;
  }
  
  .refresh-btn::after,
  .nav-btn::after {
    border: none;
  }
  
  .map-card {
    margin-top: 28rpx;
    overflow: hidden;
    border-radius: 36rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.08);
  }
  
  .map {
    width: 100%;
    height: 520rpx;
  }
  
  .selected-card {
    margin-top: 28rpx;
    padding: 34rpx;
    border-radius: 36rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .selected-title {
    color: #8b7ca8;
    font-size: 24rpx;
    font-weight: 700;
  }
  
  .selected-name {
    margin-top: 12rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .selected-desc {
    margin-top: 10rpx;
    color: #6b5b8a;
    font-size: 26rpx;
    line-height: 1.5;
  }
  
  .nav-btn {
    margin-top: 26rpx;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 28rpx;
    background: #111111;
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 800;
  }
  
  .section-title {
    margin-top: 36rpx;
    margin-bottom: 20rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .spot-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24rpx;
    margin-bottom: 20rpx;
    padding: 30rpx;
    border-radius: 32rpx;
    background: #ffffff;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .spot-card.active {
    border: 2rpx solid rgba(108, 99, 255, 0.32);
  }
  
  .spot-name {
    color: #1a1025;
    font-size: 30rpx;
    font-weight: 900;
  }
  
  .spot-desc {
    margin-top: 10rpx;
    color: #8b7ca8;
    font-size: 24rpx;
    line-height: 1.5;
  }
  
  .spot-tag {
    padding: 10rpx 20rpx;
    border-radius: 999rpx;
    background: #f7f3ff;
    color: #111111;
    font-size: 22rpx;
    font-weight: 800;
    flex-shrink: 0;
  }
  
  .empty-card {
    margin-top: 28rpx;
    padding: 60rpx 36rpx;
    border-radius: 36rpx;
    background: #ffffff;
    text-align: center;
    box-shadow: 0 12rpx 40rpx rgba(31, 20, 71, 0.06);
  }
  
  .empty-icon {
    font-size: 72rpx;
  }
  
  .empty-title {
    margin-top: 20rpx;
    color: #1a1025;
    font-size: 34rpx;
    font-weight: 900;
  }
  
  .empty-text {
    margin-top: 14rpx;
    color: #8b7ca8;
    font-size: 26rpx;
    line-height: 1.6;
  }
  