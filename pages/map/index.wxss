.map { width:100%; height:420rpx; margin:20rpx 0; overflow:hidden; }
.spot { padding:22rpx; margin-bottom:16rpx; }
.spot-head { display:flex; justify-content:space-between; align-items:center; gap:16rpx; }
.spot-name { font-size:29rpx; font-weight:700; }
.spot-type { padding:8rpx 12rpx; border-radius:999rpx; background:#ecebff; color:#5d54ff; font-size:22rpx; flex-shrink:0; }
.desc { margin-top:10rpx; color:#666; font-size:24rpx; line-height:36rpx; }
