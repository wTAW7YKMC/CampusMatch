<view class="container">
  <view class="header-card">
    <view>
      <view class="title">消息中心</view>
      <view class="subtitle">查看提案、交换和系统通知</view>
    </view>

    <button
      wx:if="{{isLoggedIn && messages.length}}"
      class="read-btn"
      bindtap="markAllRead"
    >
      全部已读
    </button>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="empty-card">
    <view class="empty-icon">🔐</view>
    <view class="empty-title">请先登录</view>
    <view class="empty-text">登录后可以查看你的提案、交换和认证消息。</view>
    <button class="login-btn" bindtap="goLogin">去我的页面登录</button>
  </view>

  <view wx:elif="{{loading}}" class="empty-card">
    <view class="empty-icon">⏳</view>
    <view class="empty-title">消息加载中</view>
  </view>

  <view wx:elif="{{!messages.length}}" class="empty-card">
    <view class="empty-icon">📭</view>
    <view class="empty-title">暂无消息</view>
    <view class="empty-text">发布、提案、认证和交换进展会出现在这里。</view>
  </view>

  <block wx:else>
    <view class="summary-card">
      <text>未读消息</text>
      <text class="count">{{unreadCount}}</text>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <view
        class="message-card {{item.read ? 'is-read' : 'is-unread'}}"
        data-id="{{item.id}}"
        bindtap="markOneRead"
      >
        <view class="icon-wrap">{{item.icon}}</view>

        <view class="message-main">
          <view class="message-top">
            <view class="message-title">{{item.title}}</view>
            <view class="message-time">{{item.time}}</view>
          </view>

          <view class="message-desc">{{item.desc}}</view>

          <view class="message-status">
            {{item.read ? '已读' : '未读，点击标记已读'}}
          </view>
        </view>

        <view wx:if="{{!item.read}}" class="dot"></view>
      </view>
    </block>
  </block>
</view>
